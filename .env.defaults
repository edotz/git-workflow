# Pins of the tool image: base image digest, tool versions and checksums, unprefixed. This file is the fallback: a .env in the plugin root overrides a key, a consuming project's .env does not.
# Compose reads it through --env-file .env.defaults, followed by --env-file .env when that exists; bin/config/env.defaults keeps the settings a project may override.

# Tool image: base image pinned by digest (docker pull --platform linux/amd64 debian:bookworm-slim, index digest from the RepoDigests of the pulled image)
IMAGE_BASE=debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3

# Tool image: linux/amd64 only, because splitsh-lite publishes no arm64 binary
IMAGE_PLATFORM=linux/amd64

# git-cliff release tag without the v; the sha512 is the one in the release's published .sha512 file of git-cliff-<version>-x86_64-unknown-linux-gnu.tar.gz
GIT_CLIFF_VERSION=2.8.0
GIT_CLIFF_SHA512=42ec0d423098f28115d38af7f95c9248ed2127c7903f16ef6558dcd6e5f625417c7a9a7bbc3b297f63db966d2196d89c2cd0d44c59a298607d7eeb1d3daa0ce1

# splitsh-lite release tag without the v; the release publishes no checksum, so the sha256 of lite_linux_amd64.tar.gz was computed once from the download
SPLITSH_VERSION=1.0.1
SPLITSH_SHA256=2539301ce5e21d0ca44b689d0dd2c1b20d9f9e996c1fe6c462afb8af4e7141cc

# GitHub CLI release tag without the v; the sha256 is the one in gh_<version>_checksums.txt of the release for gh_<version>_linux_amd64.tar.gz
GH_VERSION=2.103.3
GH_SHA256=4c806978ffce1cec70853302a56d70ac6da4f19bae7adca4e1a8ab00633dd91d

# Debian package version of git in the pinned base (apt-cache policy git after apt-get update in the base image)
GIT_APT_VERSION=1:2.39.5-0+deb12u3
