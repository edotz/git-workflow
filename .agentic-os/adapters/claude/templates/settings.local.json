  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-haiku-5-5"
  },
  "claudeMdExcludes": [
    "${PROJECT_ROOT}/CLAUDE.md"
  ],
  "outputStyle": "caveman",
