# Flat plugin settings. Every key starts with PLUGIN_EDOTZ_GIT_WORKFLOW_ and may not redefine a framework key.
# A project that uses the plugin defines MAIN_BRANCH and RELEASE_BRANCH; the values here are the fallbacks.
# There is no release strategy yet: every change goes to the main branch, so the release branch is the main branch.

PLUGIN_EDOTZ_GIT_WORKFLOW_MAIN_BRANCH=master
PLUGIN_EDOTZ_GIT_WORKFLOW_RELEASE_BRANCH=master

# Days before a branch counts as stale (git branch-cleanup)
PLUGIN_EDOTZ_GIT_WORKFLOW_STALE_DAYS=30
