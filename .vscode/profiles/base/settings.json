{
  "files.eol": "\n",
  "files.encoding": "utf8",
  "editor.fontWeight": "400",
  "editor.wordWrap": "on",
  "editor.quickSuggestions": {
    "comments": true
  },
  "terminal.external.windowsExec": "wt -p cmd cmd",
  "terminal.integrated.defaultProfile.linux": "Bash",
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "terminal.integrated.profiles.linux": {
    "bash": null,
    "Bash": {
      "path": "bash",
      "args": [
        "-li"
      ]
    }
  },
  "terminal.integrated.profiles.windows": {
    "Git Bash": {
      "source": "Git Bash"
    },
    "WSL": {
      "path": ["C:\\WINDOWS\\System32\\wsl.exe"],
      "args": ["-e", "bash", "-li"]
    }
  },
  "window.customMenuBarAltFocus": false,
  "window.zoomLevel": 1,
  "workbench.colorTheme": "Default Dark+",
  "workbench.editor.empty.hint": "hidden",
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[json][jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[dockercompose]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "remote.extensionKind": {
    "zokugun.sync-settings": ["ui"],
    "zokugun.cron-tasks": ["ui"],
    "alefragnani.project-manager": ["workspace", "ui"],
    "editorconfig.editorconfig": ["workspace", "ui"],
    "github.vscode-github-actions": ["workspace", "ui"],
    "tombonnike.vscode-status-bar-format-toggle": ["workspace", "ui"],
    "waderyan.gitblame": ["workspace", "ui"]
  },
  "security.workspace.trust.untrustedFiles": "open",
  "security.allowedUNCHosts": ["wsl.localhost", "wsl$"],
  "syncSettings.confirmSync": true,
  "syncSettings.openOutputOnActivity": true,
  "syncSettings.resources": ["extensions", "settings", "snippets"],
  "syncSettings.keybindingsPerPlatform": true,
  "syncSettings.showErrorAlert": true,
  "syncSettings.additionalFiles": [],
  "cronTasks.debug": false,
  "javascript.updateImportsOnFileMove.enabled": "never",
  "git.openRepositoryInParentFolders": "never",
  "explorer.confirmDelete": false,
  "editor.formatOnPaste": false,
  "editor.formatOnSave": false,
  "editor.formatOnType": false,
  "editor.codeActionsOnSave": {},
  "remote.autoForwardPortsSource": "hybrid",
  "github.copilot.enable": {
    "*": false
  },
  "extensions.allowed": "*",
  "chat.editing.confirmEditRequestRemoval": false,
  "git.suggestSmartCommit": false,
  "git.confirmSync": false,
  "claudeCode.preferredLocation": "panel",
  "claudeCode.selectedModel": "haiku",
  "chat.useAgentSkills": true,
  "editor.unicodeHighlight.invisibleCharacters": false,
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "json.schemaDownload.trustedDomains": {
    "https://schemastore.azurewebsites.net/": true,
    "https://raw.githubusercontent.com/": true,
    "https://www.schemastore.org/": true,
    "https://json.schemastore.org/": true,
    "https://json-schema.org/": true,
    "https://biomejs.dev": true
  },
  "git-worktree-manager.treeView.toSCM": true,
  "workbench.settings.applyToAllProfiles": []
}
